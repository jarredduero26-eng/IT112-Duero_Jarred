#include <stdio.h>

int main() {
    FILE *fp;
    int n, i, age, j;
    char name[100], course[100], line[200];

    printf("Writing Student Database:\n");
    printf("How many students do you want to record? ");

    while (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid input! Please enter a positive number: ");

        while (getchar() != '\n');
    }

    getchar();

    fp = fopen("student_records.txt", "w");

    if (fp == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    for (i = 1; i <= n; i++) {
        printf("\nStudent %d\n", i);

        printf("Enter Name: ");
        fgets(name, sizeof(name), stdin);

        for (j = 0; name[j] != '\0'; j++) {
            if (name[j] == '\n') {
                name[j] = '\0';
                break;
            }
        }

        printf("Enter Age: ");

        while (scanf("%d", &age) != 1 || age <= 0) {
            printf("Invalid age! Please enter a positive number: ");

            while (getchar() != '\n');
        }

        getchar();

        printf("Enter Course: ");
        fgets(course, sizeof(course), stdin);

        for (j = 0; course[j] != '\0'; j++) {
            if (course[j] == '\n') {
                course[j] = '\0';
                break;
            }
        }

        fprintf(fp, "Student %d\n", i);
        fprintf(fp, "Name: %s\n", name);
        fprintf(fp, "Age: %d\n", age);
        fprintf(fp, "Course: %s\n", course);
        fprintf(fp, "_____________________\n\n");
    }

    fclose(fp);

    printf("\nStudent database successfully saved to file.\n");

    fp = fopen("student_records.txt", "r");

    if (fp == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    printf("\nReading Student Database:\n\n");

    while (fgets(line, sizeof(line), fp) != NULL) {
        printf("%s", line);
    }

    fclose(fp);

    return 0;
}
