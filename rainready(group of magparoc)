#include <stdio.h>

/* Function declarations */
void displayTitle(void);
int getWeatherChoice(void);
int getRainChance(void);
int calculateRiskScore(int weather, int rainChance);
void showRecommendations(int weather, int riskScore);
void showReminders(void);

int main(void)
{
    char studentName[50];
    int weather;
    int rainChance;
    int riskScore;
    int again;

    do
    {
        displayTitle();

        printf("Enter your name: ");
        scanf("%49s", studentName);

        printf("\nHello, %s!\n", studentName);

        weather = getWeatherChoice();

        rainChance = getRainChance();

        riskScore = calculateRiskScore(weather, rainChance);

        printf("\nYour Preparation Guide\n");
        printf("----------------------\n");

        printf("Selected weather: ");

        switch (weather)
        {
            case 1:
                printf("Sunny\n");
                break;

            case 2:
                printf("Cloudy\n");
                break;

            case 3:
                printf("Light Rain\n");
                break;

            case 4:
                printf("Heavy Rain\n");
                break;
        }

        printf("Chance of rain: %d%%\n", rainChance);
        printf("Preparation score: %d/100\n", riskScore);

        showRecommendations(weather, riskScore);

        showReminders();

        printf("\nWould you like to use RainReady again?\n");
        printf("1. Yes\n");
        printf("2. No\n");
        printf("Enter your choice: ");
        scanf("%d", &again);

        while (again != 1 && again != 2)
        {
            printf("Invalid choice. Please enter 1 or 2: ");
            scanf("%d", &again);
        }

    } while (again == 1);

    printf("\nThank you for using RainReady!\n");

    return 0;
}

/* Displays the program title */
void displayTitle(void)
{
    printf("\n====================================\n");
    printf("       RAINREADY SYSTEM\n");
    printf("  Smart Weather Preparation Guide\n");
    printf("====================================\n");
}

/* Gets and validates the weather choice */
int getWeatherChoice(void)
{
    int weather;

    printf("\nHow is the weather today?\n");
    printf("1. Sunny\n");
    printf("2. Cloudy\n");
    printf("3. Light Rain\n");
    printf("4. Heavy Rain\n");
    printf("Enter your choice: ");
    scanf("%d", &weather);

    while (weather < 1 || weather > 4)
    {
        printf("Invalid choice. Enter 1 to 4: ");
        scanf("%d", &weather);
    }

    return weather;
}

/* Gets and validates the chance of rain */
int getRainChance(void)
{
    int chance;

    printf("\nEnter the chance of rain (0-100): ");
    scanf("%d", &chance);

    while (chance < 0 || chance > 100)
    {
        printf("Invalid percentage. Enter 0 to 100: ");
        scanf("%d", &chance);
    }

    return chance;
}

/* Calculates a preparation score from the user's inputs */
int calculateRiskScore(int weather, int rainChance)
{
    int score;

    score = rainChance + (weather * 5);

    if (score > 100)
    {
        score = 100;
    }

    return score;
}

/* Displays recommendations based on the selected weather */
void showRecommendations(int weather, int riskScore)
{
    printf("\nRecommendations:\n");

    switch (weather)
    {
        case 1:
            printf("- Bring water if the day is hot.\n");
            printf("- Prepare for sunny conditions.\n");
            break;

        case 2:
            printf("- Bring an umbrella just in case.\n");
            printf("- Check the weather before leaving.\n");
            break;

        case 3:
            printf("- Bring an umbrella or raincoat.\n");
            printf("- Protect your school materials.\n");
            break;

        case 4:
            printf("- Bring an umbrella or raincoat.\n");
            printf("- Protect your school bag and gadgets.\n");
            printf("- Allow extra time for your trip.\n");
            break;
    }

    if (riskScore >= 70)
    {
        printf("\nPreparation level: HIGH\n");
        printf("Prepare carefully before leaving.\n");
    }
    else if (riskScore >= 40)
    {
        printf("\nPreparation level: MODERATE\n");
        printf("Bring the items you may need.\n");
    }
    else
    {
        printf("\nPreparation level: LOW\n");
        printf("Continue checking weather updates.\n");
    }
}

/* Prints three preparation reminders */
void showReminders(void)
{
    int i;

    printf("\nBefore leaving for school:\n");

    for (i = 1; i <= 3; i++)
    {
        printf("%d. Check your school bag and travel needs.\n", i);
    }
}
