
#include <stdio.h>

int main() {
    int choice;
    float balance = 500.00;
    float amount;

    do {
        printf("\n===== BSIT-1R14 BANK =====\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
        case 1:
            printf("Your current balance is: P%.2f\n", balance);
            break;

        case 2:
            printf("Enter amount to deposit: P");
            scanf("%f", &amount);

            if (amount > 0) {
                balance = balance + amount;
                printf("Deposit successful!\n");
                printf("New balance: P%.2f\n", balance);
            }
            else {
                printf("Invalid deposit amount!\n");
            }
            break;

        case 3:
            printf("Enter amount to withdraw: P");
            scanf("%f", &amount);

            if (amount <= 0) {
                printf("Invalid withdrawal amount!\n");
            }
            else if (balance - amount < 100.00) {
                printf("Withdrawal denied!\n");
                printf("You must maintain at least P100.00 in your account\n");
            }
            else {
                balance = balance - amount;
                printf("Withdrawal successful!\n");
                printf("Remaining balance: P%.2f\n", balance);
            }
            break;

        case 4:
            printf("Thank you for using BSIT BANK!\n");
            break;

        default:
            printf("Invalid choice! Please select 1 to 4.\n");
        }

    } while (choice != 4);

    return 0;
}
